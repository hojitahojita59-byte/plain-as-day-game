; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="SOHO 1854"
config/description="Capítulo I — Broad Street"
run/main_scene="res://scenes/ui/menu_space.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
EvidenceDB="*res://scripts/autoload/evidence_db.gd"
Barrio="*res://scripts/autoload/barrio.gd"
Casefile="*res://scripts/autoload/casefile.gd"
Cuaderno="*res://scripts/autoload/cuaderno.gd"
DialogueRunner="*res://scripts/autoload/dialogue_runner.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
DoorMode="*res://scripts/autoload/door_mode.gd"
HUD="*res://scripts/autoload/hud.gd"
Ajustes="*res://scripts/autoload/ajustes.gd"
Cronometro="*res://scripts/autoload/cronometro.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

